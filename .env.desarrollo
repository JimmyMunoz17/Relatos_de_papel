# ─── API Endpoints (ejemplo) ──────────────────────────────
# Copiar este archivo como .env y ajustar los valores.
#
# Gateway principal (Spring Boot + ElasticSearch)
VITE_API_GATEWAY_BASE=http://localhost:8080/api_rest_buscador

# Servicio de facets / categorías
VITE_API_FACETS_BASE=http://localhost:8088

# Servicio operador (compras)
VITE_API_OPERATOR_BASE=http://localhost:8080/api_rest_operador

# Imagen por defecto para libros sin portada
VITE_DEFAULT_BOOK_IMG=https://res.cloudinary.com/ddbtvrcr0/image/upload/v1767207072/Relatos%20de%20papel/img_book_v0lt4v.svg

# API local Node + PostgreSQL
VITE_API_POSTGRES_BASE=http://localhost:3001/api
PORT=3001
CORS_ORIGIN=http://localhost:5173
PGHOST=localhost
PGPORT=5432
PGDATABASE=relatos_de_papel
PGUSER=postgres
PGPASSWORD=postgres
PG_BOOKS_TABLE=libros
PGSSL=false

# API local Node + PostgreSQL
VITE_API_POSTGRES_BASE=http://localhost:3001/api
PORT=3001
CORS_ORIGIN=http://localhost:5173
PGHOST=relatos-de-papel-3tier.cpymq484ib49.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=dbrelatos
PGUSER=dbrelatos
